# Copy to /etc/closa.env on the server (never commit the real file).
CLOSA_DB=/var/lib/closa/closa.db
CLOSA_BASE_URL=https://closahealth.com
# Hostinger mailbox SMTP (create hello@closahealth.com in hPanel > Emails):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@closahealth.com
SMTP_PASSWORD=change-me
MAIL_FROM=Closa Health <hello@closahealth.com>
